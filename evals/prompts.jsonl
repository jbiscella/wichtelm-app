# Behavioral eval prompts for the wichtelm-app authoring skill (one JSON object per line).
# Fields: id, prompt, must_include? (substrings that should appear in the generated .strat),
# must_exclude? (substrings that should NOT appear). Grading is primarily the real parser.
{"id": "ha-rsi-long-short", "prompt": "Write a strategy on the 1h timeframe that goes long when a bullish Heikin-Ashi reversal lines up with RSI oversold, and short on the mirror image. Use a percentage stop-loss and take-profit on the entries.", "must_include": ["Primary timeframe:", "long_entry", "short_entry", "stop_loss"]}
{"id": "ema200-atr", "prompt": "Build a daily trend-following strategy that only trades in the direction of the 200-period EMA, enters on a strong Heikin-Ashi candle, and protects each position with an ATR-based stop and take-profit.", "must_include": ["price_above_ema", "atr_value"]}
{"id": "ha-macd-4h", "prompt": "A 4h crypto strategy: enter on a strong Heikin-Ashi candle confirmed by a MACD cross, and exit on a MACD zero-line cross against the position.", "must_include": ["macd"]}
{"id": "ma-crossover", "prompt": "Daily moving-average crossover (golden/death cross style) with Heikin-Ashi confirmation, trading both long and short.", "must_include": ["sma_crosses_above_ema"]}
{"id": "multi-tf", "prompt": "An hourly strategy that trades Heikin-Ashi reversals but only in the direction of the daily EMA trend (multi-timeframe).", "must_include": ["Background", "on 1d"]}
{"id": "pivot-breakout", "prompt": "A daily strategy that trades breakouts of the standard daily pivot levels (resistance and support).", "must_include": ["pivot"]}
{"id": "ha-only-honored", "prompt": "I specifically want a Heikin-Ashi ONLY strategy on 1h with no other indicators at all. Go long on a strong bullish HA candle and exit on a strong bearish HA candle; mirror for short. Do not add RSI, MACD, or moving averages.", "must_exclude": ["rsi", "macd", "_ema", "_sma", "ema(", "sma("]}
{"id": "fix-broken-p12", "prompt": "Fix this strategy so it passes `wichtelm validate`, changing as little as possible:\n\nFeature: Broken\n  Primary timeframe: 1h\n  Scenario: enter\n    Given no open position\n    When ha_strong_bullish()\n    Then long_entry\n  Scenario: exit\n    Given a long position is open\n    When ha_strong_bearish()\n    Then long_exit\n    And with stop_loss at entry_price * 0.98", "must_include": ["long_entry", "long_exit"]}
{"id": "tune-rsi-background", "prompt": "Write a 1h strategy that uses an RSI with period 7 (not the default 14) to time entries: go long when that fast RSI crosses below 25 and exit when it crosses above 75.", "must_include": ["Background", "rsi(7)"]}
{"id": "stddev-volatility", "prompt": "A daily strategy: enter long on a strong bullish Heikin-Ashi candle only when volatility, measured as the standard deviation of close over 20 bars, is above a threshold.", "must_include": ["stddev"]}
